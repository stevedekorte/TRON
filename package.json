{
  "name": "tron-canyon-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && npm run docs && node tools/build/copy-docs.mjs && node tools/build/asset-compat.mjs && node tools/build/build-pwa.mjs && node tools/validation/check-asset-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node tools/validation/run-unit-tests.mjs",
    "test:browser": "node tests/browser/browser.mjs",
    "docs": "node tools/build/trace-blueprint.mjs && node tools/build/build-sound-library.mjs && node tools/build/build-docs.mjs",
    "worker:check": "wrangler deploy --dry-run",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@huggingface/transformers": "^4.3.1",
    "three": "^0.186.0",
    "vite": "^8.3.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.10",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "workerd@1.20261019.1": true
  }
}
