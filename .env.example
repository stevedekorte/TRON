# Server-only. Copy to .env.local and restart Vite. Never use a VITE_ prefix.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Game-owned local relay cap, independent of your purchased provider credits.
JEV_HOURLY_BUDGET_USD=1

# Public URL only; safe to embed in a static build. Never put a key here.
VITE_JEV_API_BASE=

# MCP conversation: server-only OpenAI-compatible chat endpoint and model.
# Provider choice/key are independent of JEV (which cannot generate dialogue).
# Leave blank for Gemini native generateContent; custom compatible endpoints remain supported.
MCP_CHAT_URL=
MCP_MODEL=gemini-3.8-flash
MCP_API_KEY=
# Optional public relay URL; defaults to VITE_JEV_API_BASE in production.
VITE_MCP_API_BASE=

# Optional public multiplayer server URL; local development uses the Vite server.
# Production defaults to VITE_JEV_API_BASE. Never put a secret here.
VITE_MULTIPLAYER_URL=
