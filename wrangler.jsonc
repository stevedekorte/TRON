{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tron-jev",
  "main": "workers/jev/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://dekorte.com,https://www.dekorte.com,https://encomterminal.com,https://www.encomterminal.com",
    "TYPESAFE_MODEL": "jev-latest",
    "JEV_ENABLED": "true",
    "MCP_ENABLED": "true",
    "MULTIPLAYER_ENABLED": "true",
    "MCP_MODEL": "gemini-3.8-flash",
    "DAILY_REQUESTS": "unlimited",
    "DAILY_INPUT_BYTES": "unlimited",
    "IP_DAILY_REQUESTS": "unlimited",
    "IP_MINUTE_REQUESTS": "unlimited"
  },
  "durable_objects": {
    "bindings": [{"name": "JEV_BUDGET", "class_name": "JevBudget"}, {"name":"MULTIPLAYER_ARENA", "class_name":"MultiplayerArena"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["JevBudget"]}, {"tag":"v2", "new_sqlite_classes":["MultiplayerArena"]}],
  "d1_databases": [{"binding": "ERROR_REPORTS", "database_name": "tron-error-reports", "database_id": "0b0900a5-2a2b-4ca5-8499-4d0f3a15131d", "migrations_dir": "workers/jev/migrations"}],
  "observability": {"enabled": false}
}
